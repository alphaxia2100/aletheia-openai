# Aletheia connector keys. Copy this file to the user-scoped config directory, never into a
# checkout or copied runtime:
#   ${ALETHEIA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/aletheia}/.env
# Keep it owner-readable only (chmod 600). An absent key leaves that optional connector unavailable.
# Enable/disable channels through the installed runtime, for example:
#   AL="${CODEX_HOME:-$HOME/.codex}/skills/.aletheia-runtime/skills"
#   python3 "$AL/channel-retrieval/scripts/channels.py" list
#   python3 "$AL/channel-retrieval/scripts/channels.py" enable NAME

# ============================================================
# THE SAFE CORE RUNS WITH ZERO KEYS.
# No-key default channels need NOTHING here:
#   web = marginalia + duckduckgo | primary = arxiv + openalex + europepmc
#   community = reddit archive + hackernews | depth = read.py (Jina)
# YouTube and X are opt-in capabilities. Install optional packages in a reviewed isolated virtual
# environment, then explicitly enable the channel. Browser/session access additionally needs a
# matching harness grant (ALETHEIA_BROWSER_CAPABILITY), not just a command-line flag.

# ---- FREE-KEY UPGRADES (optional, recommended) ----
BRAVE_API_KEY=                 # stronger independent web index (free tier ~2000/mo). Enable with: channels.py enable brave
OPENALEX_API_KEY=              # OpenAlex at volume (free key; keyless works at low quota)
OPENALEX_MAILTO=               # optional contact email (politeness)

# ---- PAID UPGRADES (optional, only if you want them) ----
EXA_API_KEY=                   # neural/semantic web index. channels.py enable exa
GETXAPI_KEY=                   # X paid API, cheapest 2026 (~$0.05/1k) if you prefer it over agent-reach
TWITTERAPI_IO_KEY=             # X paid API alternative (~$0.15/1k). X is color-only: never cite as evidence.

# ============================================================
# OPTIONAL (disabled + hidden channels). Enable per topic with
# scripts/channels.py, then add the key here.
# ============================================================
# Web / extraction
PERPLEXITY_API_KEY=            # cited-answer web (own hybrid index)
LINKUP_API_KEY=                # licensed-publisher index
SERPER_API_KEY=                # the ONE Google window (do NOT also add SerpAPI/PSE = same index)
FIRECRAWL_API_KEY=             # content extraction/crawl
JINA_API_KEY=                  # higher rate for read.py (works keyless at low rate)

# Academic
SEMANTIC_SCHOLAR_API_KEY=      # citation contexts + influential-citation flag (works keyless, 429-prone)
NCBI_API_KEY=                  # PubMed/E-utilities 3->10 req/s
CORE_API_KEY=                  # green-OA full-text fallback
SCITE_API_TOKEN=               # support/contrast/mention citation classification (paid)

# Community
REDDIT_CLIENT_ID=              # live/compliant Reddit via PRAW (no-key archive path is already core)
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=aletheia-surveyor/0.1 by u/yourname
STACKEXCHANGE_KEY=             # 300/day -> 10000/day (enable for technical topics)
GITHUB_TOKEN=                  # entity resolution + github channel 60->5000 req/hr

# Video / audio / books
SUPADATA_API_KEY=              # managed YouTube transcripts (for cloud/blocked IPs)
TADDY_USER_ID=                 # podcasts (free 500 req/mo)
TADDY_API_KEY=
GOOGLE_BOOKS_API_KEY=          # court-blessed snippet search
APIFY_TOKEN=                   # scraper actors
