  },
  "fake_diversity_groups": {
    "_comment": "Channels listed together resolve to ONE index. Counting two of them as independent corroboration is the fake-diversity trap. provenance_graph.py collapses them via index_group.",
    "google": ["google_serper", "serpapi", "google_pse"],
    "bing": ["duckduckgo", "bing"]
  },
  "retired": ["bing"],
  "never_cite_as_evidence": ["x", "youtube", "podcast", "reddit"],
  "skip": ["linkedin"],
  "selection_guidance": {
    "_comment": "More channels is NOT better. Fire channels by topic relevance. Irrelevant channels add noise, token cost, maintenance, and fake diversity. Pick a small, well-matched set; always cover the three roles in 'always'.",
    "always": {
      "independent_web": ["brave", "marginalia"],
      "a_primary_source": ["openalex", "arxiv", "github", "google_books"],
      "an_un_laundered_channel": ["reddit", "stackexchange", "hackernews", "youtube"]
    },
    "by_topic": {
      "software_technical_howto": ["stackexchange", "github", "hackernews", "arxiv", "reddit", "brave"],
      "science_medicine_quantitative": ["openalex", "semantic_scholar", "europepmc", "arxiv", "crossref"],
      "humanities_history_theory": ["google_books", "gutenberg", "openlibrary", "wikipedia", "marginalia", "brave"],
      "products_consumer_lived_experience": ["reddit", "youtube", "hackernews", "brave"],
      "current_trends_people": ["brave", "marginalia", "hackernews", "reddit", "youtube"]
    },
    "anti_patterns": [
      "firing all channels on every topic (noise + cost, not rigor)",
      "stacking same-index_group channels (fake diversity)",
      "using Stack Exchange for non-technical topics (near-zero signal there)",
      "treating color channels (youtube/reddit/x) as evidence"
    ]
  }
}
