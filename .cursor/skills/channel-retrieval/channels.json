{
  "_comment": "Single source of truth for retrieval channels. 'index_group' is what independence is counted over (two channels sharing an index_group are NOT independent = fake diversity). 'class' is the default epistemic weight: evidence > lead_gen > color. Scripts (provenance_graph.py) and skills read this file.",
  "core_default": ["brave", "duckduckgo", "marginalia", "openalex", "arxiv", "europepmc", "reddit", "hackernews", "github", "stackexchange", "wikipedia", "openlibrary"],
  "enabled": ["brave", "duckduckgo", "marginalia", "openalex", "arxiv", "europepmc", "reddit", "hackernews", "github", "stackexchange", "wikipedia", "openlibrary"],
  "utilities_always_on": ["read", "rerank", "provenance_graph", "dedupe", "deepen", "doctor", "entity_resolve"],
  "enabled_note": "SAFE NO-KEY FIRST. The default core uses direct, no-session web/academic/community clients: Marginalia + DuckDuckGo, arXiv + OpenAlex + Europe PMC, Wikipedia/Open Library, Reddit archive + Hacker News, GitHub, and Stack Exchange. YouTube and X are deliberately opt-in because they can require third-party tools or browser/session access. Free-key upgrades: Brave and OpenAlex; paid upgrades remain optional. Enable a hidden channel only as an explicit capability grant with channels.py enable <name>.",
  "classes": {
    "evidence": "Citable directly. Structured/primary/near-primary.",
    "lead_gen": "Use to FIND primary sources; cite the linked primary, not the aggregator.",
    "color": "Signal of what people react to. Never cite as fact."
  },
  "indexes": {
    "openalex":         { "class": "evidence", "index_group": "openalex",         "kind": "academic",           "auth": "free_key_since_2026", "citation_graph": true,  "primary_default": true },
    "semantic_scholar": { "class": "evidence", "index_group": "semantic_scholar", "kind": "academic",           "auth": "optional_key",        "citation_graph": true,  "primary_default": true },
    "arxiv":            { "class": "evidence", "index_group": "arxiv",            "kind": "academic_preprint",  "auth": "none",                "citation_graph": false, "primary_default": true },
    "europepmc":        { "class": "evidence", "index_group": "europepmc",        "kind": "academic_biomed",    "auth": "none",                "citation_graph": true,  "primary_default": true },
    "pubmed":           { "class": "evidence", "index_group": "pubmed",           "kind": "academic_biomed",    "auth": "optional_key",        "citation_graph": false, "primary_default": true },
    "crossref":         { "class": "evidence", "index_group": "crossref",         "kind": "identity_doi",       "auth": "none",                "citation_graph": "partial", "primary_default": false },
    "unpaywall":        { "class": "evidence", "index_group": "unpaywall",        "kind": "oa_resolver",        "auth": "email",               "citation_graph": false, "primary_default": false },
    "scite":            { "class": "evidence", "index_group": "scite",            "kind": "citation_intent",    "auth": "paid",                "citation_graph": true,  "primary_default": false },

    "hackernews":       { "class": "lead_gen", "index_group": "hackernews",       "kind": "community",          "auth": "none",                "primary_default": false },
    "stackexchange":    { "class": "evidence", "index_group": "stackexchange",    "kind": "community_qa",       "auth": "optional_key",        "primary_default": false },
    "discourse":        { "class": "evidence", "index_group": "per_forum",        "kind": "community_forum",    "auth": "per_instance",        "primary_default": true },
    "reddit":           { "class": "lead_gen", "index_group": "reddit",           "kind": "community",          "auth": "oauth_free",          "primary_default": false },
    "x":                { "class": "color",    "index_group": "x",                "kind": "social",             "auth": "paid",                "primary_default": false },
    "linkedin":         { "class": "skip",     "index_group": "linkedin",         "kind": "social",             "auth": "none_compliant",      "primary_default": false },

    "brave":            { "class": "evidence", "index_group": "brave",            "kind": "web_search",         "auth": "free_key",            "primary_default": false },
    "exa":              { "class": "evidence", "index_group": "exa_neural",       "kind": "web_search_neural",  "auth": "paid",                "primary_default": false },
    "perplexity":       { "class": "lead_gen", "index_group": "perplexity",       "kind": "web_answer",         "auth": "paid",                "primary_default": false },
    "linkup":           { "class": "evidence", "index_group": "linkup",           "kind": "web_search_licensed","auth": "paid",                "primary_default": false },
    "google_serper":    { "class": "lead_gen", "index_group": "google",           "kind": "web_search",         "auth": "free_tier_key",       "primary_default": false },
