    "google_pse":       { "class": "lead_gen", "index_group": "google",           "kind": "web_search",         "auth": "free_tier_key",       "primary_default": false },
    "bing":             { "class": "retired",  "index_group": "bing",             "kind": "web_search",         "auth": "retired_2025",        "primary_default": false },
    "duckduckgo":       { "class": "lead_gen", "index_group": "bing",             "kind": "web_search",         "auth": "none",                "primary_default": false },
    "marginalia":       { "class": "lead_gen", "index_group": "marginalia",       "kind": "web_search_independent","auth": "none",              "primary_default": false },

    "google_books":     { "class": "evidence", "index_group": "google_books",     "kind": "books",              "auth": "free_key",            "primary_default": true },
    "openlibrary":      { "class": "lead_gen", "index_group": "internet_archive", "kind": "books",              "auth": "none",                "primary_default": false },
    "internet_archive": { "class": "evidence", "index_group": "internet_archive", "kind": "books",              "auth": "none",                "primary_default": true },
    "gutenberg":        { "class": "evidence", "index_group": "gutenberg",        "kind": "books_public_domain","auth": "none",                "primary_default": true },
