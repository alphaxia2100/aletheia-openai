    "youtube":          { "class": "color",    "index_group": "youtube",          "kind": "video_transcript",   "auth": "paid_or_selfhost",    "primary_default": false },
    "podcast":          { "class": "color",    "index_group": "podcast",          "kind": "audio_transcript",   "auth": "mixed",               "primary_default": false },
    "github":           { "class": "evidence", "index_group": "github",           "kind": "code_repo",          "auth": "optional_token",      "primary_default": true },
